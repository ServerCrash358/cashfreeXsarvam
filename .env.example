# Copy to .env and fill in locally. Never commit .env (it is git-ignored).
SARVAM_API_KEY=
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=sandbox

# Optional: Payouts keys are separate from PG keys.
# CASHFREE_PAYOUT_CLIENT_ID=
# CASHFREE_PAYOUT_CLIENT_SECRET=
# Docs conflict on the Payouts v2 sandbox host; use whichever your keys work with.
# CASHFREE_PAYOUT_BASE_URL=https://sandbox.cashfree.com/payout
# Public URL for webhooks (ngrok or hosted).
# PUBLIC_BASE_URL=
